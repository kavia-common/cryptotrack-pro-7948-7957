# Frontend environment variables (Create React App)
# NOTE: Never commit real credentials. Copy this file to ".env" and set your values locally.

# Jira Cloud site (e.g., your-company.atlassian.net)
REACT_APP_JIRA_SITE_DOMAIN=

# Default project key for the Jira page (e.g., CRYPTO)
REACT_APP_JIRA_PROJECT_KEY=

# Jira user email for API token auth
REACT_APP_JIRA_EMAIL=

# Jira API token (create at id.atlassian.com)
REACT_APP_JIRA_API_TOKEN=

# Optional CoinGecko overrides (public)
# REACT_APP_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# REACT_APP_COINGECKO_API_KEY=
