# Copy to .env (same directory as package.json) and fill in values.
# Never commit real secrets.

# CoinGecko (optional)
REACT_APP_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# REACT_APP_COINGECKO_API_KEY=your_key_if_required_by_gateway

# Jira integration (required for Jira Burndown)
REACT_APP_JIRA_SITE_DOMAIN=your-company.atlassian.net
REACT_APP_JIRA_PROJECT_KEY=CRYPTO
REACT_APP_JIRA_EMAIL=you@example.com
REACT_APP_JIRA_API_TOKEN=your_api_token_here
